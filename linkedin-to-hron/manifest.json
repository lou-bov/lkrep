{
  "manifest_version": 3,
  "name": "LinkedIn Recruiter → HR-ON",
  "version": "2.2.0",
  "description": "Create candidates from LinkedIn Recruiter in HR-ON Recruit, with tags, job and CV.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://*.licdn.com/*",
    "https://recruit.hr-on.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "LinkedIn → HR-ON"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/talent/*"
      ],
      "js": [
        "extract.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
